{
  "expo": {
    "name": "Serenity",
    "slug": "serenity",
    "scheme": "serenity",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.serenity.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#7C5CBF"
      },
      "package": "com.serenity.app"
    },

    "plugins": [
      "expo-router"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
